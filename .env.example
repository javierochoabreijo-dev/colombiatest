# ColombiaTest · variables de entorno
# Copia este archivo a ".env.local" y rellena con tus claves de Supabase.
# En Vite, TODAS las variables expuestas al cliente deben empezar por VITE_.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# NOTA: la anon key es pública por diseño (protegida por Row Level Security).
# NUNCA pongas aquí la service_role key.
