{
  "name": "colombiatest-video",
  "private": true,
  "description": "Video promocional de ColombiaTest: escena.html animada por tiempo y renderizada fotograma a fotograma.",
  "scripts": {
    "qr": "node qr.js",
    "vertical": "node render.js --fmt v --texto 1 --out out/colombiatest_vertical_con-texto.mp4",
    "horizontal": "node render.js --fmt h --texto 1 --out out/colombiatest_horizontal_con-texto.mp4",
    "vertical:limpio": "node render.js --fmt v --texto 0 --out out/colombiatest_vertical_limpio.mp4",
    "horizontal:limpio": "node render.js --fmt h --texto 0 --out out/colombiatest_horizontal_limpio.mp4"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4"
  }
}
